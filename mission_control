async def monitor_mission(drone: System):
    # Simple telemetry monitoring
    async for bat in drone.telemetry.battery():
        if bat.remaining_percent is not None:
            print(f"Battery: {bat.remaining_percent*100:.1f}%")
        await asyncio.sleep(1.0)
        break

async def main():
    drone = System()
    # connect to the vehicle; change the URL for your link (SITL: udp://:14540) or serial: serial:///dev/ttyACM0:921600
    print("Connecting to drone on udp://:14540 ...")
    await drone.connect(system_address="udp://:14540")

    await wait_for_connection(drone)

    # set home if not predefined
    home = await set_home_if_none(drone)

    # Set speed
    await drone.action.set_maximum_speed(CRUISE_SPEED_MS)

    # Arm and takeoff
    await arm_and_takeoff(drone, TAKEOFF_ALT)

    # Navigate to target waypoint
    ok = await goto_location(drone, TARGET_WAYPOINT[0], TARGET_WAYPOINT[1], TARGET_WAYPOINT[2])
    if not ok:
        print("Aborted mission - returned early.")
        return

    # Do any mission tasks here (hover, sensor capture)
    print("At waypoint — hovering for 5s")
    await asyncio.sleep(5)

    # Return to Home (RTL) - do a safe return
    print("Initiating RTL back to Home...")
    await initiate_rtl(drone)

    # Wait until close to home, then attempt precision landing using vision
    # Watch position, and when close horizontally & altitude is low, run precision landing
    while True:
        pos = await get_current_position(drone)
        lat, lon, abs_alt = pos
        dist_home = haversine_m(lat, lon, home[0], home[1])
        print(f"Distance to home: {dist_home:.1f} m, alt: {abs_alt:.1f} m")
        if dist_home <= 15.0 and abs_alt <= 6.0:
            # Call precision landing sequence with a vision callback
            await precision_land_sequence(drone, vision_marker_callback=dummy_vision_marker_detector)
            break
        await asyncio.sleep(1.0)

    # Wait for landed and disarm
    print("Waiting for disarm...")
    async for in_air in drone.telemetry.in_air():
        if not in_air:
            print("Landed.")
            break
        await asyncio.sleep(0.5)

    print("Disarming...")
    try:
        await drone.action.disarm()
    except Exception as e:
        print("Disarm call may have failed or already disarmed:", e)

    print("Mission complete.")

if __name__ == "__main__":
    asyncio.run(main())
