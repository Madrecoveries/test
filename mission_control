# mission_control.py
# Requires: pip install mavsdk asyncio opencv-python apriltag-python (if using marker), numpy
# This script is an example companion-computer mission controller for PX4 using MAVSDK.
# It uses async/await and assumes MAVSDK server is reachable (e.g. UDP:14540 for SITL or serial for real hardware).

import asyncio
import math
import time
from mavsdk import System
from mavsdk import (Telemetry, Action, Offboard, PositionNedYaw)
import numpy as np

# --- CONFIG ---
TARGET_WAYPOINT = ( -37.810000, 144.960000, 10.0 )  # lat, lon, altitude (m) - example, replace
HOME_COORD = None  # if None, set automatically to vehicle's home on connect
TAKEOFF_ALT = 10.0  # meters
CRUISE_SPEED_MS = 5.0
GOTO_TOLERANCE_M = 2.5
LANDING_ALT_THRESHOLD_M = 1.5  # if below this and marker not found, attempt land
LOW_BATTERY_THRESHOLD = 20  # percent
RTL_ALTITUDE = 12.0  # altitude for RTL
CONNECTION_TIMEOUT = 30  # s
# ----------------

async def wait_for_connection(drone: System, timeout=CONNECTION_TIMEOUT):
    connected = False
    start = time.time()
    async for state in drone.core.connection_state():
        if state.is_connected:
            print(f"Connected to drone with UUID: {state.uuid}")
            connected = True
            break
        if time.time() - start > timeout:
            break
    if not connected:
        raise RuntimeError("Failed to connect to drone within timeout")

def haversine_m(lat1, lon1, lat2, lon2):
    # returns distance in meters
    R = 6371000.0
    phi1 = math.radians(lat1)
    phi2 = math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlambda = math.radians(lon2 - lon1)
    a = math.sin(dphi/2)**2 + math.cos(phi1)*math.cos(phi2)*math.sin(dlambda/2)**2
    return 2*R*math.asin(math.sqrt(a))

async def get_current_position(drone: System):
    async for pos in drone.telemetry.position():
        return (pos.latitude_deg, pos.longitude_deg, pos.absolute_altitude_m)

async def set_home_if_none(drone: System):
    global HOME_COORD
    if HOME_COORD is not None:
        print("Using configured HOME_COORD")
        return HOME_COORD
    # Wait for GPS fix & position
    print("Waiting for GPS fix and first position...")
    async for health in drone.telemetry.health():
        if health.is_global_position_ok:
            print("Global position OK")
            break
    pos = await get_current_position(drone)
    HOME_COORD = (pos[0], pos[1], pos[2])
    print(f"Home set to {HOME_COORD}")
    return HOME_COORD

async def arm_and_takeoff(drone: System, altitude_m):
    print("Arming...")
    await drone.action.set_takeoff_altitude(altitude_m)
    await drone.action.arm()
    await asyncio.sleep(1)
    print("Taking off...")
    await drone.action.takeoff()
    # wait until reaching altitude (rough)
    reached = False
    async for position in drone.telemetry.position():
        cur_alt = position.relative_altitude_m
        print(f"Takeoff - relative alt {cur_alt:.1f} m")
        if cur_alt >= altitude_m*0.9:
            reached = True
            break
        await asyncio.sleep(0.5)
    if not reached:
        print("Warning: did not reach takeoff altitude as expected")

async def goto_location(drone: System, lat, lon, alt):
    # Use action.goto_location (lat, lon, alt, yaw_deg) if available, else use mission items
    print(f"Navigating to {lat:.7f}, {lon:.7f}, {alt}m")
    # mavsdk.action.goto_location expects absolute altitude above WGS84 ellipsoid in meters.
    # Using Telemetry to get current position to compute flight.
    await drone.action.goto_location(lat, lon, alt, 0.0)
    # monitor progress
    while True:
        pos = await get_current_position(drone)
        if pos is None:
            await asyncio.sleep(0.5)
            continue
        dist = haversine_m(pos[0], pos[1], lat, lon)
        print(f"Distance to target: {dist:.1f} m, current alt rel: {pos[2]:.1f}m")
        if dist <= GOTO_TOLERANCE_M:
            print("Reached waypoint (within tolerance).")
            break
        # battery check
        async for bat in drone.telemetry.battery():
            if bat.remaining_percent is not None and bat.remaining_percent*100 <= LOW_BATTERY_THRESHOLD:
                print("Low battery detected during transit! Initiating RTL.")
                await initiate_rtl(drone)
                return False
            break
        await asyncio.sleep(1)
    return True

async def initiate_rtl(drone: System):
    print("Setting RTL altitude then returning to launch (RTH).")
    await drone.action.set_return_to_launch_altitude(RTL_ALTITUDE)
    await drone.action.return_to_launch()

async def precision_land_sequence(drone: System, vision_marker_callback=None):
    """
    Try to detect vision marker for precision landing.
    vision_marker_callback should be an async function that returns (found:bool, lat, lon) or None.
    """
    print("Starting precision landing sequence.")
    # Descend slowly while searching for marker
    current_pos = await get_current_position(drone)
    target_lat, target_lon, _ = current_pos
    descent_step = 1.0  # m
    min_alt = 0.3
    # tell FC to land if marker not found after some smaller altitude
    while True:
        pos = await get_current_position(drone)
        _, _, rel_alt = pos
        print(f"Precision landing: current rel alt {rel_alt:.2f} m")
        if vision_marker_callback is not None:
            found, lat, lon = await vision_marker_callback()
            if found:
                print("Marker found! Navigating to marker and descending for precision landing.")
                # direct descent to marker using goto_location then land
                await drone.action.goto_location(lat, lon, rel_alt + 0.5, 0.0)
                await asyncio.sleep(1)
                await drone.action.land()
                return
        if rel_alt <= LANDING_ALT_THRESHOLD_M:
            print("Marker not found and close to ground threshold — performing normal land.")
            await drone.action.land()
            return
        # step down by commanding position with a lower altitude (if supported), else set landing
        # Here we just sleep and let the FC handle slow landing by switching to LAND mode at the right moment.
        # Alternatively, could command velocity downwards via Offboard.
        await asyncio.sleep(1.0)

